{
  "$defs": {
    "ActionConflict": {
      "additionalProperties": false,
      "description": "409 响应体：附最新快照供前端重建（08 §4 第 3 步）。",
      "properties": {
        "code": {
          "enum": [
            "stale_version",
            "stale_card",
            "not_allowed_now",
            "run_active"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": true,
          "description": "SessionSnapshot 序列化结果；此处用 dict 避免循环引用",
          "title": "Snapshot",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "snapshot"
      ],
      "title": "ActionConflict",
      "type": "object"
    },
    "ActionResult": {
      "additionalProperties": false,
      "description": "写入 session_actions.result_json 并在幂等重放时返回。",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "version_after": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version After"
        }
      },
      "required": [
        "action_id",
        "run_id"
      ],
      "title": "ActionResult",
      "type": "object"
    },
    "ConfirmProposalAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "description": "前端生成的 uuid，重试时复用，服务端据此幂等",
          "title": "Action Id",
          "type": "string"
        },
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "input_token": {
          "title": "Input Token",
          "type": "string"
        },
        "kind": {
          "const": "confirm_proposal",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ConfirmProposalPayload"
        },
        "target_issue_id": {
          "title": "Target Issue Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "expected_version",
        "target_issue_id",
        "input_token",
        "card_id",
        "kind",
        "payload"
      ],
      "title": "ConfirmProposalAction",
      "type": "object"
    },
    "ConfirmProposalPayload": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "title": "Option Id",
          "type": "string"
        }
      },
      "required": [
        "option_id"
      ],
      "title": "ConfirmProposalPayload",
      "type": "object"
    },
