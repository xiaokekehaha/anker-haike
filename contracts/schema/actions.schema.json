    "StepAnswer": {
      "additionalProperties": false,
      "description": "问句卡 / 材料卡的回答：选项原文或短答；material_request 可声明暂时没有。",
      "properties": {
        "option": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Option"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "unavailable": {
          "default": false,
          "title": "Unavailable",
          "type": "boolean"
        }
      },
