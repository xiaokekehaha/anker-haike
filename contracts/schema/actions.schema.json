        "input_token",
        "card_id",
        "kind",
        "payload"
      ],
      "title": "StepFeedbackAction",
      "type": "object"
    },
    "StepFeedbackPayload": {
      "additionalProperties": false,
      "description": "action 卡交 feedback；question / material_request 卡交 answer；statement 卡两者都可省（确认已读）。\n服务端按卡片 kind 校验组合（sessions/router.py）。",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepAnswer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feedback": {
          "anyOf": [
            {
              "enum": [
                "solved",
                "not_solved",
                "cannot_do"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "StepFeedbackPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "confirm_proposal": "#/$defs/ConfirmProposalAction",
      "confirm_receipt": "#/$defs/ConfirmReceiptAction",
      "decline_proposal": "#/$defs/DeclineProposalAction",
      "new_issue": "#/$defs/NewIssueAction",
      "rate_satisfaction": "#/$defs/RateSatisfactionAction",
      "request_human": "#/$defs/RequestHumanAction",
      "resume_issue": "#/$defs/ResumeIssueAction",
      "select_product": "#/$defs/SelectProductAction",
      "skip_receipt": "#/$defs/SkipReceiptAction",
      "skip_retake": "#/$defs/SkipRetakeAction",
      "step_feedback": "#/$defs/StepFeedbackAction"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SelectProductAction"
    },
    {
      "$ref": "#/$defs/StepFeedbackAction"
    },
    {
      "$ref": "#/$defs/ConfirmReceiptAction"
    },
    {
      "$ref": "#/$defs/SkipReceiptAction"
    },
    {
      "$ref": "#/$defs/RequestHumanAction"
    },
    {
