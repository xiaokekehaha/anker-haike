    },
    {
      "$ref": "#/$defs/DeclineProposalAction"
    },
    {
      "$ref": "#/$defs/SkipRetakeAction"
    },
    {
      "$ref": "#/$defs/RateSatisfactionAction"
    }
  ],
  "title": "ActionRequest"
}
