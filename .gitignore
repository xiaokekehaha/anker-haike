data/knowledge/manifest.json
data/knowledge/snapshots/

# 回滚前的 config 临时快照（票 49）
releases/_pre-rollback/

# 票 46：代理证书与口令文件只在部署机
deploy/proxy/certs/
deploy/proxy/.htpasswd

# 会话追踪和脱敏日志（本地产物）
logs/

# 票 42：bake-off 明细报告（bakeoff.md 结论抄进 findings，JSON 不入库）
reports/bakeoff/*.json
# 阶段 0/1 的字段级评测：结论表 bakeoff.md 入库，逐样本明细 JSON 不入库
reports/bakeoff-*/*.json
# 真实评测照片只在本机
data/bakeoff-images/
reports/inspection/*.json
reports/inspection/inspection-*.md

# QA 录屏原始素材：帧图 174M、视频 8.6M 只留本机，文档保留结论和文本记录
docs/planning/*_qa-video-recording/frames/
docs/planning/*_qa-video-recording/frames.json
docs/planning/*_qa-video-recording/video.ffconcat
docs/planning/*_qa-video-recording/*.mp4
docs/planning/*_qa-video-recording/*.png

# 票 43：回放校验失败明细只留本机
replay/.failures/
data/demo-photos/

# 主办方资料包（46M docx/xlsx，评测 sources.json 只记路径与 sha256）
docs/【黑客松智能服务赛道】工具资料包/

# 2026-10-09 官方 63 单评测：真实模型跑出的会话轨迹、探针脚本与日志只留本机，结论与复核写在同目录 md 里
docs/planning/2026-10-09-*/**/*.json
docs/planning/2026-10-09-*/**/*.py
docs/planning/2026-10-09-*/**/*.log
docs/planning/2026-10-09-*/**/*.diff
docs/planning/2026-10-09-*/**/*.txt
docs/planning/2026-10-09-*/**/*.jpg
docs/planning/2026-10-09-*/**/*.jpeg
docs/planning/2026-10-09-*/**/*.png

# 2026-10-10 评测与复现：沿用本地产物忽略范围，Markdown 结论与复核文档入库
docs/planning/2026-10-10-*/**/*.json
docs/planning/2026-10-10-*/**/*.py
docs/planning/2026-10-10-*/**/*.log
docs/planning/2026-10-10-*/**/*.diff
docs/planning/2026-10-10-*/**/*.txt
docs/planning/2026-10-10-*/**/*.jpg
docs/planning/2026-10-10-*/**/*.jpeg
docs/planning/2026-10-10-*/**/*.png

# 评测原始会话：统一只留本机，不依赖日期或任务名，规划与报告文档入库
docs/planning/**/conversations/

# 多轮复现与复测：完整会话和逐轮翻译只留本机，结论与根因文档入库
docs/planning/*_multiturn-reproduction/完整会话记录.md
docs/planning/*_post-makeup-multiturn-retest/本次原文完整会话.md
docs/planning/*_post-makeup-multiturn-retest/**/原文完整会话.md
docs/planning/*_post-makeup-multiturn-retest/**/回复原文与中文翻译.md

# 视觉模型对比：原始 jsonl、铭牌照片与明细 json 只留本机，methodology.md 入库
reports/vision-comparison-20261009/*.jsonl
reports/vision-comparison-*/*.json
reports/vision-comparison-20261009/inputs/
