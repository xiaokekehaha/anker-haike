# 票 46：HTTPS 反向代理（nginx 官方镜像会用 envsubst 渲染本模板）
# 变量：PROXY_SERVER_NAME（默认 _）、PROXY_RATE（默认 10r/s）、PROXY_BURST（默认 20）、PROXY_UPSTREAM（默认 http://orchestrator:8000）
limit_req_zone $binary_remote_addr zone=perip:10m rate=${PROXY_RATE};

server {
    listen 80;
    server_name ${PROXY_SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PROXY_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 容器 DNS，运行期解析上游，nginx -t 不依赖上游存在
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $upstream ${PROXY_UPSTREAM};

    client_max_body_size 6m;   # 图片上传 5 MB 上限由应用判定（票 29），代理略放宽

    # 探针无需认证；聚合健康仍需认证（含组件与模型配置信息）
    location = /health/live {
        auth_basic off;                       # 探针免认证，但同样限速
        limit_req  zone=perip burst=${PROXY_BURST} nodelay;
        limit_req_status 429;
        proxy_pass $upstream;
    }

    location / {
        auth_basic           "haike";
        auth_basic_user_file /etc/nginx/.htpasswd;
        limit_req            zone=perip burst=${PROXY_BURST} nodelay;
        limit_req_status     429;

        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Authenticated-User $remote_user;
        proxy_set_header Authorization "";   # 不把基础认证头透传给应用

        # SSE 透传：不缓冲、不缓存、长读超时（run deadline 最长 40 s，续接可能更久）
        proxy_buffering off;
        proxy_cache     off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header X-Accel-Buffering no;
    }
}
