# 复制为 .env 后填写。默认测试厂商为 DeepSeek，其余可留空。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MODEL_LANE=domestic

# ---- Compose 端口 ----
ORCHESTRATOR_PORT=8000
WEKNORA_PORT=8080
WEKNORA_UI_PORT=8081
POSTGRES_PORT=5432

# ---- PostgreSQL（WeKnora 库 + 编排服务库共用一个实例）----
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=WeKnora
HAIKE_DB_USER=haike
HAIKE_DB_PASSWORD=haike
HAIKE_DB_NAME=haike
REDIS_PASSWORD=redis123

# ---- WeKnora ----
WEKNORA_VERSION=v0.8.0
WEKNORA_API_KEY=            # 票 26：在 WeKnora UI 建 tenant 后填写
WEKNORA_JWT_SECRET=haike-dev-jwt-secret-change-me
WEKNORA_SYSTEM_AES_KEY=haike-dev-aes-key-32bytes-change!
EMBEDDING_MODEL_NAME=text-embedding-v4   # 票 26：百炼 embedding，1024 维；key 复用 DASHSCOPE_API_KEY
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL_NAME=gte-rerank-v2
SSRF_WHITELIST_EXTRA=      # 本机用 embedding 桩时填 host.docker.internal（deploy/dev/embedding_stub.py）
WEKNORA_TENANT_PASSWORD=   # 票 26：make kb-bootstrap 自助注册项目 tenant 用的口令（本地开发）

# ---- 本机直接跑编排服务时（make dev-api）----
DATABASE_URL=postgresql://haike:haike@localhost:5432/haike
REDIS_URL=redis://:redis123@localhost:6379/0
WEKNORA_BASE_URL=http://localhost:8080
MODELS_CONFIG_PATH=       # 默认仓库根 config/models.yaml

# ---- 数据库备份（票 47，compose 服务 pg-backup）----
BACKUP_INTERVAL_S=86400      # 备份周期（秒）
BACKUP_RETENTION_DAYS=7      # 保留天数

# ---- 镜像构建源（构建机拉 PyPI / npm 慢时填国内镜像）----
UV_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org/

# ---- 回放模式（票 43，演示网络不稳时用）----
# REPLAY_CASE_ID=a1_hair_wrap   # 非空即启用：模型与知识库全部按 replay/<case_id>/ 录制包回放；清单不符启动报 replay_incompatible
# REPLAY_DIR=replay             # 录制包目录（镜像内 /srv/replay）
# KB_VER=                       # 无 data/knowledge/manifest.json 时直接给出 kb_ver 供清单比对
