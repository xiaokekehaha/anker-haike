# 复制为 .env 后填写。默认测试厂商为 DeepSeek，其余可留空。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MODEL_LANE=domestic

# ---- Compose 端口 ----
ORCHESTRATOR_PORT=8000
WEKNORA_PORT=8080
WEKNORA_UI_PORT=8081
POSTGRES_PORT=5432

# ---- PostgreSQL（WeKnora 库 + 编排服务库共用一个实例）----
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=WeKnora
HAIKE_DB_USER=haike
HAIKE_DB_PASSWORD=haike
HAIKE_DB_NAME=haike
REDIS_PASSWORD=redis123

# ---- WeKnora ----
WEKNORA_VERSION=v0.8.0
WEKNORA_API_KEY=            # 票 26：在 WeKnora UI 建 tenant 后填写
WEKNORA_JWT_SECRET=haike-dev-jwt-secret-change-me
WEKNORA_SYSTEM_AES_KEY=haike-dev-aes-key-32bytes-change!
EMBEDDING_MODEL_NAME=text-embedding-v4   # 票 26：百炼 embedding，1024 维；key 复用 DASHSCOPE_API_KEY
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL_NAME=gte-rerank-v2
SSRF_WHITELIST_EXTRA=      # 本机用 embedding 桩时填 host.docker.internal（deploy/dev/embedding_stub.py）
# WeKnora 自带「快速问答 / 智能推理」智能体要的对话模型与视觉语言模型（deploy/weknora/builtin_models.yaml 登记）。
# 留空即用 compose 默认：对话 deepseek-flash（复用 DEEPSEEK_API_KEY）、视觉 qwen3-vl-plus（复用 DASHSCOPE_API_KEY）。
# 只在换厂商时才填，改完 `docker compose up -d weknora-app` 重启即同步。编排服务主链路不读这几个变量。
LLM_MODEL_NAME=            # 例：glm-4.7
LLM_BASE_URL=              # 例：https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=               # 留空则取 DEEPSEEK_API_KEY
VLM_MODEL_NAME=            # 例：glm-4.6v
VLM_BASE_URL=              # 例：https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=               # 留空则取 DASHSCOPE_API_KEY
WEKNORA_TENANT_PASSWORD=   # 票 26：make kb-bootstrap 自助注册项目 tenant 用的口令（本地开发）

# ---- 本机直接跑编排服务时（make dev-api）----
DATABASE_URL=postgresql://haike:haike@localhost:5432/haike
REDIS_URL=redis://:redis123@localhost:6379/0
WEKNORA_BASE_URL=http://localhost:8080
MODELS_CONFIG_PATH=       # 默认仓库根 config/models.yaml

# ---- 数据库备份（票 47，compose 服务 pg-backup）----
BACKUP_INTERVAL_S=86400      # 备份周期（秒）
BACKUP_RETENTION_DAYS=7      # 保留天数

# ---- 镜像构建源（构建机拉 PyPI / npm 慢时填国内镜像）----
UV_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org/

# ---- 数据保留与人工删除（票 48，07 §12：图片 1 h / 会话 24 h / 追踪 7 d）----
# RETENTION_SESSION_HOURS=24    # 过期且无 active run 的会话整体删除（投影 / 事件 / 动作 / 图片 / checkpoint）
#                               # 演示期建议 168（7 天）：管理员观测台的会话详情要能回看完整时间线

# ---- 管理员观测台（docs/planning/2026-09-13_admin-observability-console）----
# 旁路采集，写库失败不影响业务；关掉只是面板没有新数据
# ANALYTICS_ENABLED=true
# ANALYTICS_QUEUE_CAPACITY=2000  # 队列满即丢弃并计数，业务永不等待写库
# ANALYTICS_FLUSH_MS=1000
# ANALYTICS_STORE_TEXT=true      # 会话首问是否入库（脱敏并截断到 200 字）
# ANALYTICS_ABANDON_AFTER_H=6    # 未终结会话多久算「放弃」（查询时现算）
# RETENTION_TRACE_DAYS=7        # JSONL 轮转备份保留天数（检索追踪随 checkpoint 一起过期）
# RETENTION_INTERVAL_S=600      # 清理循环周期（秒）
ADMIN_TOKEN=                    # 非空才开启 DELETE /sessions/{id}（请求头 X-Admin-Token）；生产放密钥文件

# ---- 告警（票 50，进程内规则；不配渠道则只写日志 event=alert，/health.alerts 可看）----
ALERT_WEBHOOK_URL=              # 飞书 / 钉钉 / 企业微信 / Slack 机器人地址；POST JSON 带 text 与 alert
# ALERT_EMAIL_TO=ops@example.com  # 邮件投递（逗号分隔）；需同时配 ALERT_SMTP_HOST / PORT / USER / PASSWORD / FROM
# ALERT_COOLDOWN_S=300           # 同一规则冷却
# ALERT_MODEL_FAIL_STREAK=3      # 模型链连续失败次数
# ALERT_RETRIEVAL_EMPTY_RATE=0.5 # 最近 20 次检索为空 / 不可用占比
# ALERT_QUEUE_REJECT_RATE=0.2    # 60 s 内队列拒绝率（且 ≥ 5 次）
# ALERT_HEALTH_FAIL_STREAK=3     # /health 连续非 ok 次数（每 ALERT_HEALTH_INTERVAL_S=60 探测一次）

# ---- 可观测（票 44，默认只写本地 logs/events.jsonl）----
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# OBSERVABILITY_LOG_PATH=logs/events.jsonl

# ---- 回放模式（票 43，演示网络不稳时用）----
# REPLAY_CASE_ID=a1_hair_wrap   # 非空即启用：模型与知识库全部按 replay/<case_id>/ 录制包回放；清单不符启动报 replay_incompatible
# REPLAY_DIR=replay             # 录制包目录（镜像内 /srv/replay）
# KB_VER=                       # 无 data/knowledge/manifest.json 时直接给出 kb_ver 供清单比对
