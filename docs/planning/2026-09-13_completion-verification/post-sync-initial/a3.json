          "score": 0.015246842709529276,
          "status": "ok"
        },
        {
          "evidence_id": "d7badee2-702d-48c0-a7ff-94b349d1a9e4",
          "source": "kb_tickets",
          "doc_id": "T0187",
          "doc_version": "2026-09-12.1",
          "chunk_id": "d7badee2-702d-48c0-a7ff-94b349d1a9e4",
          "snippet": "工单 T0187｜产品 EUFY-X10-PRO-OMNI\n现象：不充电\n原因：基站触点脏污\n处理步骤：擦拭触点后手动放回基站\n结果：solved",
          "score": 0.01520966595593461,
